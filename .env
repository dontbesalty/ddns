# Cloudflare Settings
# Replace with your actual Cloudflare API Token (needs Zone:DNS:Edit permission)
CF_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
# Replace with your actual Zone ID (find on Cloudflare dashboard Overview page)
CF_ZONE_ID="YOUR_ZONE_ID"
# Replace with the DNS record name you want to update (e.g., home.yourdomain.com)
RECORD_NAME="subdomain.example.com"
# Record type (usually A for IPv4) - uncomment if you need something other than A
# RECORD_TYPE="A"

# Pushover Notification Settings (Optional)
# Set to true or false to enable/disable Pushover notifications
PUSHOVER_ENABLE=true
# Replace with your Pushover User Key (find on Pushover dashboard)
PUSHOVER_USER_KEY="YOUR_PUSHOVER_USER_KEY"
# Replace with your Pushover Application API Token (create on Pushover website)
PUSHOVER_API_TOKEN="YOUR_PUSHOVER_API_TOKEN"
